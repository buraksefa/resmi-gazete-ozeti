# User-Agent'a yazılır; zorunlu (e-posta veya proje URL'si)
GAZETE_CONTACT=
# İsteğe bağlı ayarlar
# GAZETE_DELAY_S=5
# GAZETE_MAX_REQUESTS=80
# GAZETE_BACKFILL_PER_RUN=2
# GAZETE_BACKFILL_DAYS=365

# Faz 2 — yerel LLM (Ollama). Anahtar gerekmez; tailnet içinden erişilir.
GAZETE_OLLAMA_URL=http://bsasrv:11434
GAZETE_OLLAMA_MODEL=gemma3:4b          # özetler
GAZETE_OLLAMA_MODEL_OLGU=qwen2.5:7b    # atama/vekâlet olguları
GAZETE_LLM_NUM_THREAD=2               # Ollama CPU iş parçacığı (ısınmayı azaltır; 0 = sınırsız)
GAZETE_OCR_DINLENME=1.0               # OCR sayfa süresinin bu katı kadar dinlenme
GAZETE_LLM_ARA_S=30                   # her özetten sonra bekleme (sn)

# Faz 3 — herkese açık site. GAZETE_YAYIN: github | cloudflare | (boş = yalnız ev ağı)
GAZETE_YAYIN=github
GAZETE_SITE_URL=https://buraksefa.github.io/resmi-gazete-ozeti
GAZETE_GITHUB_DEPO=github-gazete:buraksefa/resmi-gazete-ozeti.git
# Cloudflare Workers'a yüklemek için (GAZETE_YAYIN=cloudflare). Anahtar yalnız "Workers Scripts: Edit" yetkili olsun.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
